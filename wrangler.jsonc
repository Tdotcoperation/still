{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"still",
 "main":"worker.js",
 "compatibility_date":"2026-10-28",
 "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/r2/*"]},
 "env":{"r2":{"name":"still","r2_buckets":[{"binding":"MEDIA","bucket_name":"still-media"}],"assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/r2/*"]}}}
}
